# Smart Solar Monitoring Pay-As-You-Go Energy Platform
# Copy this file to .env and fill in real values before running.

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solarpayg
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_SSL=false
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_MS=3000

# JWT Authentication
JWT_SECRET=your-super-secret-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your-safaricom-consumer-key
MPESA_CONSUMER_SECRET=your-safaricom-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Africa's Talking SMS / USSD
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=SOLARPAYG
AT_SHORTCODE=YOUR_SHORTCODE

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_RECONNECT_PERIOD=5000

# PAYG Token
TOKEN_VALIDITY_HOURS=72
TOKEN_LENGTH=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_MPESA_MAX_REQUESTS=10

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Admin bootstrapping (replace before deployment)
ADMIN_EMAIL=admin@solarpayg.com
ADMIN_PASSWORD=Admin@12345
