# ═══════════════════════════════════════════════════════════════════════════════
# Smart Solar Monitoring Pay-As-You-Go Energy Platform
# Environment Configuration File
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION ENVIRONMENT & PORT
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solarpayg
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION SECRETS
# Generate secure keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep these EXTREMELY SECRET - never commit to version control
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-minimum-32-characters-generated-above
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# M-PESA DARAJA API (Safaricom)
# Get credentials from: https://developer.safaricom.co.ke/
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
# ─────────────────────────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your-safaricom-consumer-key
MPESA_CONSUMER_SECRET=your-safaricom-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey-from-safaricom
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/callback
MPESA_ENVIRONMENT=sandbox

# ─────────────────────────────────────────────────────────────────────────────
# PAYG TOKEN CONFIGURATION
# Token validity in hours and token length in characters
# ─────────────────────────────────────────────────────────────────────────────
TOKEN_VALIDITY_HOURS=72
TOKEN_LENGTH=8

# ─────────────────────────────────────────────────────────────────────────────
# AFRICA'S TALKING (USSD/SMS Integration)
# Get credentials from: https://africastalking.com/
# ─────────────────────────────────────────────────────────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=SOLARPAYG

# ─────────────────────────────────────────────────────────────────────────────
# MQTT BROKER CONFIGURATION
# Local: mqtt://localhost:1883 (Mosquitto)
# Cloud: URL from HiveMQ Cloud or AWS IoT Core
# ─────────────────────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_RECONNECT_PERIOD=5000

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# Limit requests per IP to prevent abuse
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND & CORS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional - for notifications)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDER_EMAIL=noreply@solarpaygo.com

# ─────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION (Optional - for caching)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & DEBUGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN CREDENTIALS (Change immediately after initial setup!)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@solarpaygo.com
ADMIN_PASSWORD=your-secure-password-here-change-immediately

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
