# ── Database (required) ───────────────────────────────────────────────────────
# Local:   postgresql://solarpayg:solarpayg_password@localhost:5432/solarpayg
# Render:  set automatically when you attach the PostgreSQL add-on
DATABASE_URL=postgresql://user:password@localhost:5432/solarpayg

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never reuse this example value — anyone with this string can forge login tokens.
JWT_SECRET=  
JWT_EXPIRES_IN=24h

# ── Demo accounts (seeded automatically on every server boot) ─────────────────
# Both default to placeholder domains — fine if RESEND_API_KEY below is blank
# (no emails are sent), but if you DO have email notifications on, every login
# as that account will attempt real delivery. ADMIN_EMAIL defaults to
# admin@solarpayg.com (doesn't exist — bounces). CUSTOMER_EMAIL defaults to
# customer@example.com (a reserved documentation domain — won't NXDOMAIN-bounce,
# but has no real inbox either). Set both to a real address you control. The
# users.email column is UNIQUE, so they can't be identical — if you only have
# one inbox, use Gmail's "+" alias for one of them (e.g. you+demo@gmail.com
# still delivers to you@gmail.com but is a distinct address).
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
# Password for the seeded demo customer account (defaults to Customer@12345).
# Like ADMIN_PASSWORD, overriding it makes the login page stop displaying the
# well-known default.
CUSTOMER_PASSWORD=

# ── Email notifications: login alerts + signup confirmation, via Resend ───────
# Both notification types go through Resend (leave blank to disable both).
# 1. Sign up free at https://resend.com (3,000 emails/month free, no card needed)
# 2. Dashboard -> API Keys -> Create API Key -> paste it below
# 3. RESEND_FROM_EMAIL: use "onboarding@resend.dev" to start testing immediately
#    — but it ONLY delivers to the email address your Resend account itself is
#    registered under, not arbitrary recipients. For login alerts to reach real
#    users (not just you), verify a domain under Domains in the Resend
#    dashboard, then switch this to e.g. "SolGrid <noreply@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── M-Pesa (leave blank to use simulation mode — payments confirm after 3 s) ──
# Get your own consumer key/secret from https://developer.safaricom.co.ke — never commit real values here.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Standard Safaricom sandbox test passkey (safe to share, documented publicly by Safaricom)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox
# Required before going live: a secret appended to the callback URL we send Safaricom,
# and checked on every inbound callback, so /api/mpesa/callback can't be forged by someone
# who simply knows their own checkoutRequestId. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=

# ── Device telemetry ───────────────────────────────────────────────────────────
# Shared fallback key for devices that haven't been individually provisioned yet
# (see POST /api/admin/devices, admin-only, for per-device keys — preferred for
# real hardware so a leaked key only affects one unit). Leave blank to accept
# unauthenticated telemetry for any unprovisioned deviceId — fine for demos only.
DEVICE_API_KEY=

# How long (ms) a device can go without a telemetry report before the admin
# dashboard marks it offline. Defaults to 60000 (60s) if unset — the ESP32
# firmware reports every 5s (UPDATE_INTERVAL in firmware/esp32-firmware.ino),
# so this tolerates several missed sends before flapping to offline.
DEVICE_OFFLINE_TIMEOUT_MS=60000

# ── Error monitoring: Sentry (leave blank to disable) ──────────────────────────
# 1. Sign up free at https://sentry.io (free tier covers small projects)
# 2. Create a project -> platform Node.js/Express -> copy the DSN it gives you
# Without this, crashes only show up in Render's log stream (still logged with
# a [FATAL] marker and full stack — see server.js — just no alerting).
SENTRY_DSN=
