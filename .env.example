# ── Database (required) ───────────────────────────────────────────────────────
# Local:   postgresql://solarpayg:solarpayg_password@localhost:5432/solarpayg
# Render:  set automatically when you attach the PostgreSQL add-on
DATABASE_URL=postgresql://user:password@localhost:5432/solarpayg

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never reuse this example value — anyone with this string can forge login tokens.
JWT_SECRET=  
JWT_EXPIRES_IN=24h

# ── Email notifications (leave blank to disable login alerts) ─────────────────
# Use a Gmail account + an App Password (not your normal password):
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification enabled)
EMAIL_USER=
EMAIL_PASS=

# ── M-Pesa (leave blank to use simulation mode — payments confirm after 3 s) ──
# Get your own consumer key/secret from https://developer.safaricom.co.ke — never commit real values here.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Standard Safaricom sandbox test passkey (safe to share, documented publicly by Safaricom)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox
# Required before going live: a secret appended to the callback URL we send Safaricom,
# and checked on every inbound callback, so /api/mpesa/callback can't be forged by someone
# who simply knows their own checkoutRequestId. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=

# ── Device telemetry (leave blank to accept readings from any deviceId — fine for
#    demos, but set this before connecting real hardware so /api/telemetry can't be
#    spoofed) ────────────────────────────────────────────────────────────────────
# Must match the X-Device-Key header your ESP32 firmware sends.
DEVICE_API_KEY=
