{
  "name": "solarpaygo-platform",
  "version": "3.0.0",
  "description": "Smart Solar Monitoring Pay-As-You-Go Energy Platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --forceExit --coverageThreshold='{}'",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint -c .eslintrc.cjs src __tests__ --max-warnings 50",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint -c .eslintrc.cjs src __tests__ --fix",
    "seed": "node src/scripts/seed.js",
    "migrate": "node src/scripts/migrate.js",
    "build": "node --check src/server.js && echo \"Build OK: Node.js syntax validated\""
  },
  "keywords": [
    "solar",
    "payg",
    "energy",
    "iot",
    "mpesa",
    "mqtt",
    "websocket"
  ],
  "author": "Solar PAYG Team",
  "license": "ISC",
  "dependencies": {
    "africastalking": "^0.6.2",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.3.4",
    "node-cron": "^3.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.7",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.5",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/__tests__/setup.js"],
    "testMatch": ["**/__tests__/**/*.test.js"],
    "testPathIgnorePatterns": ["/node_modules/", "/Solar/"],
    "transformIgnorePatterns": [
      "node_modules/(?!(supertest)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/scripts/**",
      "!src/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
